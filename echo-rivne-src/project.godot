[application]
config/name="ECHO//RIVNE"
run/main_scene="res://Main.tscn"
config/icon="res://assets/icon.svg"

[display]
window/size/width=1280
window/size/height=720
window/size/test_width=960
window/size/test_height=540
window/stretch/mode="2d"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[rendering]
quality/driver/driver_name="GLES2"
quality/driver/fallback_to_gles2=true
vram_compression/import_etc=true
vram_compression/import_etc2=false
vram_compression/import_s3tc=false
quality/shadows/filter_mode=0
quality/shadows/filter_mode.mobile=0
quality/directional_shadow/size=2048
quality/directional_shadow/size.mobile=1024
environment/default_clear_color=Color(0.035, 0.045, 0.06, 1)

[physics]
3d/default_gravity=22.0

[input]
move_forward={"deadzone":0.5,"events":[Object(InputEventKey,"physical_scancode":87)]}
move_back={"deadzone":0.5,"events":[Object(InputEventKey,"physical_scancode":83)]}
move_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_scancode":65)]}
move_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_scancode":68)]}
sprint={"deadzone":0.5,"events":[Object(InputEventKey,"physical_scancode":16777237)]}
interact={"deadzone":0.5,"events":[Object(InputEventKey,"physical_scancode":69)]}
phone={"deadzone":0.5,"events":[Object(InputEventKey,"physical_scancode":80)]}
vehicle={"deadzone":0.5,"events":[Object(InputEventKey,"physical_scancode":70)]}
save_game={"deadzone":0.5,"events":[Object(InputEventKey,"physical_scancode":16777268)]}
inventory={"deadzone":0.5,"events":[Object(InputEventKey,"physical_scancode":73)]}
map={"deadzone":0.5,"events":[Object(InputEventKey,"physical_scancode":77)]}
